{
  "expo": {
    "name": "Divide Certo",
    "slug": "divide-certo",
    "scheme": "dividecerto",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.divide-certo"
    },
    "android": {
      "package": "com.anonymous.dividecerto",
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F3"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      "./plugins/with-fmt-cxx17"
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "f65a593f-91fa-4d67-8246-d8512c960230"
      }
    },
    "owner": "josuegiraos-team"
  }
}
